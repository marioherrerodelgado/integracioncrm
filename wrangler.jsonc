{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "integracioncrm",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  // URL pública del proyecto de Supabase. La clave service_role NO va aquí:
  // es un secreto del Worker (npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY).
  // Las variables de texto creadas a mano en el dashboard se pierden en cada deploy.
  "vars": {
    "SUPABASE_URL": "https://uplszvhiqwtmzoyucdip.supabase.co"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Sin binding, env.ASSETS es undefined y el Worker lanza 1101 (HTTP 500)
    // en toda ruta que no corresponda a un asset existente.
    "binding": "ASSETS",
    // Sirve 404.html con status 404 en lugar de dejar caer la peticion al Worker.
    "not_found_handling": "404-page"
  }
}
